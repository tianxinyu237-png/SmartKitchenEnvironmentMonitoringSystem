# ===== CMSIS 里本项目用不到的大块（省 18MB） =====
Drivers/CMSIS/DSP/
Drivers/CMSIS/NN/
Drivers/CMSIS/DAP/
Drivers/CMSIS/Documentation/
Drivers/CMSIS/RTOS/
Drivers/CMSIS/RTOS2/
Drivers/CMSIS/Core_A/
# 只留 stm32f407 的器件头文件，其余 F4 型号全部忽略（白名单写法最可靠）
Drivers/CMSIS/Device/ST/STM32F4xx/Include/stm32f4*.h
!Drivers/CMSIS/Device/ST/STM32F4xx/Include/stm32f407xx.h

